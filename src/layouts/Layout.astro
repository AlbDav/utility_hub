---
import { pwaInfo } from 'virtual:pwa-info';
import { pwaAssetsHead } from 'virtual:pwa-assets/head';
import Icon from '../components/Icon.astro';
import Marchio from '../components/Marchio.astro';
import '../styles/global.css';

interface Props {
  title: string;
  /** Riga sotto il titolo. */
  subtitle?: string;
  /** La home ha il marchio al posto del ritorno alla home. */
  home?: boolean;
}

const { title, subtitle, home = false } = Astro.props;
const pageTitle = home ? 'Cassetta degli attrezzi' : `${title} · Cassetta`;
---

<!doctype html>
<html lang="it" data-theme="officina" class="bg-base-200">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{pageTitle}</title>

    {pwaAssetsHead.themeColor && <meta name={pwaAssetsHead.themeColor.name} content={pwaAssetsHead.themeColor.content} />}
    {pwaAssetsHead.links.map((link) => <link {...link} />)}
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

    <!-- iOS: apertura a schermo intero dalla schermata Home -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cassetta" />

    <script>
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </head>
  <body class="min-h-dvh bg-base-200 font-sans text-base-content antialiased">
    <header class="border-b-2 border-base-content pt-[env(safe-area-inset-top)]">
      <div class="mx-auto flex max-w-3xl flex-col gap-4 px-5 pt-5 pb-5">
        {
          home ? (
            <>
              <div class="flex items-center gap-3">
                <Marchio size={44} />
                <div class="flex flex-col gap-[3px]">
                  <span class="display text-xl leading-none">Cassetta</span>
                  <span class="font-mono text-[10px] tracking-[0.22em] uppercase">degli attrezzi</span>
                </div>
              </div>
              <h1 class="display mt-3 text-[2rem]">{title}</h1>
            </>
          ) : (
            <>
              <a
                href="/"
                class="inline-flex min-h-11 items-center gap-1.5 self-start font-mono text-[13px] font-medium tracking-[0.06em] uppercase"
              >
                <Icon name="indietro" strokeWidth={2.5} />
                Cassetta
              </a>
              <div class="flex flex-col gap-1.5">
                <h1 class="display text-[2.125rem]">{title}</h1>
                {subtitle && <p class="text-[15px] text-neutral">{subtitle}</p>}
              </div>
            </>
          )
        }
        <slot name="header" />
      </div>
    </header>
    <main class="mx-auto max-w-3xl px-5 pt-5 pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
      <slot />
    </main>
  </body>
</html>
