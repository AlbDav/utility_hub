---
import Layout from '../layouts/Layout.astro';
import { utilities, percorso } from '../utilities';
---

<Layout title="Hub" back={false}>
  <ul class="grid gap-3 sm:grid-cols-2">
    {utilities.map((utility) => (
      <li>
        <a href={percorso(utility)} class="card bg-base-100 shadow-sm transition hover:shadow-md">
          <div class="card-body flex-row items-center gap-4">
            <span class="text-4xl" aria-hidden="true">{utility.icona}</span>
            <div>
              <h2 class="card-title">{utility.nome}</h2>
              <p class="text-sm opacity-70">{utility.descrizione}</p>
            </div>
          </div>
        </a>
      </li>
    ))}
  </ul>
</Layout>
