# Copia in .env e compila. Su Netlify vanno in Site settings → Environment variables.

# Musical – Planner prove
# ID di «File → Condividi → Pubblica sul web» (la parte dopo /d/e/ nella URL pubblicata)
PUBLIC_MUSICAL_SHEET_ID=
# gid di ogni scheda (il numero dopo #gid= nella URL del foglio)
PUBLIC_MUSICAL_GID_SCENE=
PUBLIC_MUSICAL_GID_PERSONAGGI=
PUBLIC_MUSICAL_GID_CAST=
PUBLIC_MUSICAL_GID_PROVE=
# true = usa le fixture in public/fixtures/musical anche se gli ID sono compilati.
# Se manca anche un solo ID, l'app usa comunque le fixture.
PUBLIC_MUSICAL_USE_FIXTURES=false
# Data della prima (aaaa-mm-gg o gg/mm/aaaa): conto alla rovescia in home e nella vista Scene.
PUBLIC_MUSICAL_DATA_PRIMA=

# Obiettivi – Settimana e giorno
# Stesso ID di «File → Condividi → Pubblica sul web» del foglio degli obiettivi
PUBLIC_OBIETTIVI_SHEET_ID=
# gid della scheda con la griglia (il numero dopo #gid= nella URL del foglio).
# Facoltativo: se lo lasci vuoto si legge la prima scheda.
PUBLIC_OBIETTIVI_GID_SETTIMANA=
# true = usa la fixture in public/fixtures/obiettivi anche se l'ID è compilato.
# Se manca l'ID, l'app usa comunque la fixture.
PUBLIC_OBIETTIVI_USE_FIXTURES=false
